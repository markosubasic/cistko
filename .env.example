# Copy to .env and fill in. Never commit .env.

# --- PostgreSQL (one server, three databases: blizu, cistko, nabavaradar; this app uses cistko) ---
POSTGRES_PASSWORD=change-me
# Host port of the dev database; change it if 5432 is already taken on your machine
DB_PORT=5432

# --- Identification towards external sources (used in the HTTP User-Agent) ---
CONTACT_EMAIL=marko.subasic@susfer.hr

# --- SMTP (dev: Mailpit on 127.0.0.1:1025) ---
# Use 127.0.0.1, not "localhost": compose publishes IPv4 only and "localhost" can stall for
# ~40 s per connection on Windows while IPv6 (::1) is tried first.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost

# --- Hostname used by Caddy in production ---
CISTKO_HOST=cistko.localhost

# --- Core settings (read by opendata_core.config.CoreSettings) ---
APP_NAME=datathon
ENV=dev
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:change-me@127.0.0.1:5432/cistko
HTTP_CACHE_DIR=.http-cache
HTTP_TIMEOUT_S=20
NOMINATIM_URL=https://nominatim.openstreetmap.org
PUBLIC_BASE_URL=http://localhost:5173

# --- Release metadata (set by CI / deploy) ---
GIT_SHA=dev

# Per-IP request budget of every API (slowapi syntax); raise it when many users share one IP
RATE_LIMIT=60/minute

# --- Čistko (see apps/cistko/.env.example for details) ---
WASTE_WFS_URL=https://servisi.azo.hr/otpad/wfs
