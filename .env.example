# Copy to .env and fill in. Never commit .env.

# --- PostgreSQL (one server, three databases: blizu, otporno, nabavaradar) ---
POSTGRES_PASSWORD=change-me

# --- Identification towards external sources (used in the HTTP User-Agent) ---
CONTACT_EMAIL=marko.subasic@susfer.hr

# --- SMTP (dev: Mailpit on 127.0.0.1:1025) ---
# Use 127.0.0.1, not "localhost": compose publishes IPv4 only and "localhost" can stall for
# ~40 s per connection on Windows while IPv6 (::1) is tried first.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost

# --- Hostnames used by Caddy in production ---
BLIZU_HOST=blizu.localhost
OTPORNO_HOST=otporno.localhost
NABAVA_HOST=nabavaradar.localhost

# --- Core settings (read by opendata_core.config.CoreSettings) ---
APP_NAME=datathon
ENV=dev
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:change-me@127.0.0.1:5432/blizu
HTTP_CACHE_DIR=.http-cache
HTTP_TIMEOUT_S=20
NOMINATIM_URL=https://nominatim.openstreetmap.org
PUBLIC_BASE_URL=http://localhost:5173

# --- Release metadata (set by CI / deploy) ---
GIT_SHA=dev

# Per-IP request budget of every API (slowapi syntax); raise it when many users share one IP
RATE_LIMIT=60/minute

# --- Otporko (see apps/otporno/.env.example for details) ---
OPEN_METEO_CLIMATE_URL=https://climate-api.open-meteo.com/v1/climate
HV_WMS_URL=https://servisi.voda.hr/wms

# --- NabavaRadar (see apps/nabavaradar/.env.example for details) ---
# Sudski registar credentials end with ".."; confirm the e-mail on the portal first (else HTTP 401 on data calls)
SUDREG_CLIENT_ID=
SUDREG_CLIENT_SECRET=
SUDREG_BASE_URL=https://sudreg-data.gov.hr/api/javni
SUDREG_TOKEN_URL=https://sudreg-data.gov.hr/api/oauth/token
# Signs unsubscribe tokens; required by docker-compose.prod.yml
SUBSCRIPTION_SECRET=
