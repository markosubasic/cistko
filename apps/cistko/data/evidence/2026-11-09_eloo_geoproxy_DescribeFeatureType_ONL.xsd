<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ELOO-APP="ELOO-APP" xmlns:gml="http://www.opengis.net/gml" elementFormDefault="qualified" targetNamespace="ELOO-APP">
