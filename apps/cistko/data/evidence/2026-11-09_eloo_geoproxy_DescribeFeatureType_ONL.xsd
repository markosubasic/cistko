          <xsd:element maxOccurs="1" minOccurs="1" name="Id" nillable="false" type="xsd:int"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="geom" nillable="true" type="gml:GeometryPropertyType"/>
          <xsd:element maxOccurs="1" minOccurs="1" name="AdministrativeWasteReportStatusId" nillable="false" type="xsd:int"/>
          <xsd:element maxOccurs="1" minOccurs="1" name="WasteDataStatusId" nillable="false" type="xsd:int"/>
          <xsd:element maxOccurs="1" minOccurs="1" name="WasteLocationStatusId" nillable="false" type="xsd:int"/>
