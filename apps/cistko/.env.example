# Čistko API settings (copy values into the repository-root .env or export them).
DATABASE_URL=postgresql+psycopg://postgres:change-me@127.0.0.1:5432/cistko
CONTACT_EMAIL=marko.subasic@susfer.hr

# Address search anywhere in Croatia (cached 30 days)
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Waste-management WFS of the Ministry (Open Data Portal: gospodarenje-otpadom-wfs)
WASTE_WFS_URL=https://servisi.azo.hr/otpad/wfs

# Raw downloads
DATA_DIR=apps/cistko/data

# Browser origins allowed to call the API (explicit list, no wildcard)
CORS_ORIGINS=http://localhost:5177,http://127.0.0.1:5177
