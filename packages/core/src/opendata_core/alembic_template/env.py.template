"""Alembic env.py template for an app: copy to apps/<app>/api/migrations/env.py.

Reads DATABASE_URL from the environment / .env via CoreSettings and combines the core metadata
(data_source, ingestion_run, geocode_cache) with the app's own metadata.
"""

from alembic import context
from sqlalchemy import create_engine

from opendata_core.config import CoreSettings
from opendata_core.db import Base as CoreBase

# from <app>.models import Base as AppBase   # <- app tables
target_metadata = [CoreBase.metadata]  # + [AppBase.metadata]

settings = CoreSettings()


def run_migrations_online() -> None:
    engine = create_engine(settings.database_url)  # raises if unset
    with engine.connect() as connection:
        context.configure(connection=connection, target_metadata=target_metadata)
        with context.begin_transaction():
            context.run_migrations()


if context.is_offline_mode():
    raise SystemExit("offline mode is not supported")
run_migrations_online()
